  // cvim-hello -- a package to test the package manager with.
  //
  // It deliberately has a VERSION you can see on screen, so the update path is
  // testable end to end: install it, bump VERSION on GitHub, then :so on the
  // :Pkg page and watch the badge appear.
  //
  //   :Hello        toggle the card
  //   <leader>h     the same
  //   q / Esc       close it while it has focus

  string VERSION = "1.0.0";

  class Hello {
      int  panel;
      int  opened;

      Hello(){ panel = 0; opened = 0; }

      void paint(int aw, int ah){
          int cw = cvim.draw.cell_w();
          int ch = cvim.draw.cell_h();
          if (cw <= 0) { cw = 8; }
          if (ch <= 0) { ch = 16; }

          // Card, with a bevel so it reads as chrome rather than as text.
          cvim.draw.color(24, 28, 38, 245);
          cvim.draw.round(0, 0, aw, ah, 5);
          cvim.draw.color(70, 90, 130, 255);
          cvim.draw.rect(0, 0, aw, ah);

          cvim.draw.color(140, 190, 255, 255);
          cvim.draw.text(cw, ch - 4, " hello from a package ");

          cvim.draw.color(205, 212, 226, 255);
          cvim.draw.text(cw, ch * 2 + 2, " version   " + VERSION);
          cvim.draw.text(cw, ch * 3 + 2, " opened    " + cvim.str(opened) + "x");

          string p = cvim.buf.path();
          if (p == "") { p = "[No Name]"; }
          cvim.draw.text(cw, ch * 4 + 2, " buffer    " + p);
          cvim.draw.text(cw, ch * 5 + 2, " lines     " + cvim.str(cvim.buf.count()));
          cvim.draw.text(cw, ch * 6 + 2, " tabstop   " + cvim.str(cvim.opt.tabstop));

          cvim.draw.color(150, 158, 176, 255);
          cvim.draw.text(cw, ch * 8 + 2, " q or Esc to close");
      }

      // Panel input. kind 7 is a key, and it only arrives while the panel holds
      // focus -- which is what stops these keys leaking into the buffer.
      void key(int kind, int x, int y, int wheel, string k){
          if (kind != 7) { return; }
          if (k == "q" || k == "<Esc>") { close(); }
      }

      void open(){
          if (panel != 0) { return; }
          opened = opened + 1;
          panel  = cvim.draw.panel(4, 2, 40, 10, this.paint);
          cvim.draw.input(panel, this.key);
          cvim.draw.focus(panel);
          cvim.msg("cvim-hello " + VERSION);
      }

      void close(){
          if (panel == 0) { return; }
          cvim.draw.focus(0);
          cvim.draw.close(panel);
          panel = 0;
      }

      void toggle(string arg){
          if (panel == 0) { open(); } else { close(); }
      }
  }

  Hello g_hello = new Hello();

  // A package is loaded on its own, in its own engine, so it defines setup()
  // directly. (A *bundled* plugin shares one program with plugins.c4 and exposes
  // <name>_setup() instead -- that difference matters only in this repo.)
  void setup(){
      cvim.cmd.add("Hello", g_hello.toggle);
      cvim.map.n("<leader>h", g_hello.toggle);
  }
